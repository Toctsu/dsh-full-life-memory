{
  "name": "@tuhengyu/dsh-full-life-memory",
  "version": "0.2.3",
  "description": "仿生终身记忆：上下文放不下时把旧轮次蒸馏成 token 线索并从历史切除，需要时用 recall_from_clues 把线索重建成回忆。",
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "memory",
    "context",
    "sqlite"
  ],
  "author": "tuhengyu",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "types": "index.ts",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "index.ts",
    "cordis.patch.yml",
    "tsconfig.json",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
